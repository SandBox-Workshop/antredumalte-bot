{
  "name": "antredumalt",
  "version": "0.1.1",
  "description": "Bot Discord privé multi-jeux pour l'Antre du Malt.",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx ./index.ts",
    "deploy": "tsx ./deploy-commands.ts",
    "dev": "tsx watch ./index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "keywords": [
    "discord",
    "bot",
    "gaming",
    "multigame",
    "vrising"
  ],
  "author": "creep Gaming",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "bufferutil": "^4.1.0",
    "discord.js": "^14.26.4",
    "gamedig": "^5.3.3",
    "googleapis": "^173.0.0",
    "tsx": "^4.23.15",
    "zlib-sync": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/gamedig": "^5.0.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.5.0",
    "globals": "^17.13.0",
    "release-it": "^20.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
